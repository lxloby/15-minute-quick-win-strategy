{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backtest - all pairs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_backtest.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Backtest - EURJPY only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_backtest.py",
      "args": ["--symbols", "EURJPY", "--out-dir", "out_eurjpy"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Backtest - EURJPY longs 2022+",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_backtest.py",
      "args": ["--symbols", "EURJPY", "--direction", "long",
               "--start-date", "2022-01-01", "--out-dir", "out_eurjpy_2022_long"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Backtest - ask me for the arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_backtest.py",
      "args": "${command:pickArgs}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Preview breaker charts",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/preview_breakers.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Fetch M15 data (MT5 must be running)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/fetch_data.py",
      "args": ["--timeframes", "M15"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Build news calendar",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/convert_calendar.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
